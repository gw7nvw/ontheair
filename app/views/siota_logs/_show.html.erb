<div id="actionbar" class="span7">
  <div id="crumbs">
    <%=link_to "Home", '/', remote: true,  :id => 'home', :onclick => "linkHandler('home')" %>
    &nbsp;--&gt;&nbsp;
    <%=link_to "SiOTA Logs", '/siota_logs/?'+@parameters, remote: true,  :id => 'index', :onclick => "linkHandler('home')" %>
    &nbsp;--&gt;&nbsp;
    <b><%=@user.callsign+" / "+@park.code+" / "+@logdate%></b>
  </div>
  <div id="controls">
    <%=link_to "Index", '/siota_logs/?'+@parameters, class: "btn btn-small btn-primary", remote: true,  :id => 'index', :onclick => "linkHandler('index')" %>
    <%=render 'map_controls'%>
  </div>
</div>

<div class="erow">
  <br/>
  <br/>
  <p>
  Please check that the following log is correct, and click the <b>Download</b> button to download the log. You can then upload the log to SiOTA at <%=link_to "https://www.silosontheair.com/logs/upload", "https://www.silosontheair.com/logs/upload", target: "_blank" %> <img src="/icons/external-link-symbol.png">
  </p>

  <br/>
  <br/>
  Filename: <%=@filename%><br/>
  <br/>
  <% @siota_log.split('<eor>').each do |siota_log| %>
    <%=if siota_log and siota_log.length>1 then siota_log+"<eor>" end%><br/>
  <% end %>
  <br/>
  <br/>
  Contacts accepted: <%=@contacts.count-@duplicate_contacts.count-@invalid_contacts.count%>
  Duplicate contacts rejected: <%=@duplicate_contacts.count%><br/>
  <% @duplicate_contacts.each do |contact| %>
    <%=link_to "Contact: "+contact.id.to_s, '/contacts/'+contact.id.to_s ,remote: true, :onclick => "linkHandler('submit')"%> <%=contact.callsign1%>&lt;=&gt;<%=contact.callsign2%><br/>
  <% end %>
  Invalid contacts rejected: <%=@invalid_contacts.count%><br/>
  <% @invalid_contacts.each do |contact| %>
    <%=link_to "Contact: "+contact[:contact].id.to_s, '/contacts/'+contact[:contact].id.to_s ,remote: true, :onclick => "linkHandler('submit')"%> <%=contact[:contact].callsign1%>&lt;=&gt;<%=contact[:contact].callsign2%> -- <%=contact[:message]%><br/>
  <% end %>
  <% if @contacts.count-@duplicate_contacts.count-@invalid_contacts.count > 0 %>
    <%=link_to "Download Log", '/siota_logs/'+@park.safecode+"/download.adi?date="+@logdate+"&user="+@user.callsign, class: "btn btn-small btn-primary" %>
  <% else %>
    <p><b>There are no valid contacts in this log.  Please correct any errors and try again</b></p>
  <% end %>
  <%=link_to "Cancel", '/siota_logs?user='+@user.callsign, class: "btn btn-small btn-primary",remote: true, :onclick => "linkHandler('submit')"%>
</div>
<script>
  document.body.classList.remove('loading');
  document.getElementById('actionbar-full').innerHTML=document.getElementById('actionbar').innerHTML;
</script>


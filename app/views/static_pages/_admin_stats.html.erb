<script>
  function onload_tasks() {
    reset_map_controllers();
    if ($(window).width() < 960) {
      site_smaller_map();
    }
  }
  if (window.map_is_ready) {
    onload_tasks();
  } else {
    window.addEventListener('map:loaded', onload_tasks, { once: true });
  }

  document.getElementById("page_status").innerHTML = '';
  document.body.classList.remove('loading');
  document.title = <%= raw(@site_title) %>
  document.getElementById('logo').innerHTML = <%= raw(@site_title) %>
</script>

<div id="actionbar" class="span7">
   <div id="crumbs">
     <%=link_to "Home", '/', remote: true,  :id => 'home', :onclick => "linkHandler('home')" %>
     &nbsp;--&gt;&nbsp;
     <b>Admin</b>
   </div>
   <div id="controls">
     <%=render 'map_controls'%>
   </div>
</div>

<div id="right_scroll">
  <%= render 'flash' %>

  <div class="erow">
     <div class="hrline">
        <hr noshade size="4">
     </div>
  </div>

  <div class="rowtitle">Memory</div>
  <div class='erow'>
    <%=raw @memstats.gsub(/[\r\n]+/, '<br/>')%>
  </div>

  <div class="erow">
     <div class="hrline">
        <hr noshade size="4">
     </div>
  </div>

  <div class="rowtitle">Disk</div>
  <div class='erow'>
    <%=raw @diskstats.gsub(/[\r\n]+/, '<br/>')%>
  </div>

  <div class="erow">
     <div class="hrline">
        <hr noshade size="4">
     </div>
  </div>

  <div class="rowtitle">Background jobs</div>
  <div class='erow'>
    <%=raw @resque_workers.gsub(/[\r\n]+/, '<br/>')%>
  </div>

  <div class="erow">
     <div class="hrline">
        <hr noshade size="4">
     </div>
  </div>

   <div class="rowtitle"><%=link_to "Tasks", '/admin_tasks', :id => 'admin_tasks', remote: true,  :id => 'view', :onclick => "linkHandler('admin_tasks')" %></div>
   <div class="rowtitle"><%=link_to "Resque", '/resque', target: '_blank',  :id => 'resque' %></div>
   <div class="rowtitle"><%=link_to "Netdata", '/netdata', target: '_blank',  :id => 'netdata' %></div>
   <div class="rowtitle"><%=link_to "IP Blocking", '/blocks', :id => 'blocks', remote: true,  :id => 'view', :onclick => "linkHandler('blocks')" %></div>
</div>


<script>
  document.getElementById('actionbar-full').innerHTML=document.getElementById('actionbar').innerHTML;
</script>


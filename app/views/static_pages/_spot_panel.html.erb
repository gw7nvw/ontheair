<div id="refresh-container" data-seq="<%=@last_spot_seq_id%>">
<% as=AdminSettings.first %>
  <% if as and as.last_spot_read then
       last_spot_read=as.last_spot_read.in_time_zone(@tz.name).strftime("%H:%M:%S")
       if as.last_spot_read<5.minutes.ago then stale=true end
     else
       last_spot_read="Unknown"
       stale=true
     end %>
  <% if stale==true
      #Need to put a set a lock flag here to prevent parallel execution of this (resulting in 2 workers)
      #Should really do this in controller ...
      unlocked = ActiveRecord::Base.connection.execute("SELECT pg_try_advisory_lock( #{SCHED_LOCK} );")
      if unlocked and unlocked.values and unlocked.values.first and unlocked.values.first.first=='t' then
        puts "UNLOCKED"
        begin
          sch_running=system('ps -ef | grep ota_schedule | grep resqu | grep -v grep')
          if sch_running==false then
            success=system('RAILS_ENV=production nohup bundle exec rake environment resque:work QUEUE=ota_scheduled > log/redisch.log & echo $! > /tmp/schedule.pid')
            if !success then
              flashlocal="Error: process to retrieve remote spots failed and we could not restart it"
              flashlocaltype='error'
            else
              flashlocal="Success: process to retrieve remote spots failed but we successfully restarted it. Remote spots will show on the next refresh"
              flashlocaltype='success'
            end
          end
        rescue
          puts "ERROR: failed in scheduler process check"
        end
        #And release lock
        ActiveRecord::Base.connection.execute("SELECT pg_advisory_unlock( #{SCHED_LOCK} );")
      end
     end
  %>
  <% if flashlocal then %>
    <div class="alert alert-<%= flashlocaltype %>"><%= flashlocal %></div>
  <% end%>
 
  <p style="margin-bottom: 0px"><span <%=if stale then raw("style='color: #900'") end%> >Last updated: <%=last_spot_read%> (<%=@tz.name%>)</span> - <span id="retrieved">Retrieved at <%=Time.now.in_time_zone(@tz.name).strftime("%H:%M:%S")%> (<%=@tz.name%>)</span><i>&nbsp;<%=  link_to "Refresh Now", '/spots?'+raw(@parameters), remote: true,  :onclick => "linkHandler(event,'refresh_link')"%> </i></p>
  <%= render 'alert_summary' %>
  <h2>Spots</h2>
  <%= render 'spot_list' %>
</div>

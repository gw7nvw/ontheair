
<script>
  function refreshData() {
    //only if we're still on spots page
    if(document.getElementById('spots')) {
      $.ajax({
        beforeSend: function (xhr){
          xhr.setRequestHeader("Content-Type","application/javascript");
          xhr.setRequestHeader("Accept","text/javascript");
        },
        type: "GET",
        timeout: 20000,
        url: "/spot_panel/",
        data: <%=raw(@params_json)%>, 
        dataType: "script", // Automatically sets Accept headers and handles execution
        success: function(data, textStatus, jqXHR) {
          // Unlock the gate when the request finishes (win or lose)
          site_isCurrentlyFetching = false; 

          var currentSeq = $('#refresh-container').data('seq');
          if (currentSeq !== undefined && currentSeq !== null) {

          // On the very first AJAX run, prime the variable without playing the sound
          if (window.lastKnownSeq === null) {
            window.lastKnownSeq = currentSeq;
          }
          // On subsequent runs, play the sound only if the sequence has changed
          else if (currentSeq !== window.lastKnownSeq) {
            console.log("PLAY SOUND");
            playAlertSound();
            window.lastKnownSeq = currentSeq;
          }
        }
          /* complete also fires when error ocurred, so only clear if no error has been shown */
          console.log("COMPLETE");
          startTimer();
        },
        error: function(jqXHR, textStatus, thrownError) {
          if(thrownError=="timeout") {
             document.getElementById('retrieved').innerHTML="<p><b>TIMED OUT</b></p>";
          } else {
             document.getElementById('retrieved').innerHTML="<p><b>ERROR: "+textStatus+"</b></p>";
          }

          site_isCurrentlyFetching = false;
          console.log("ERROR");
          startTimer();
        }
      });
    } else {
      // If the element wasn't found, make sure to unlock the flag just in case
      site_isCurrentlyFetching = false;
     };
  }
    
  function startTimer() {
    try {
      pauseTimer();
      console.log("START");
      refreshInterval = setTimeout(refreshData, 60000); /* time in milliseconds (ie 60 seconds)*/
    }
    catch(err) {
    } 
    finally {
    }
  }
    
  function pauseTimer() {
    console.log("PAUSE");
    if (refreshInterval) {
      clearTimeout(refreshInterval);
      refreshInterval = null; // Clear the variable
    }
  }

  function playAlertSound() {
    // 1. Check if the user has enabled sound
    var soundEnabled = document.getElementById('enable-sound').checked;

    if (!soundEnabled) {
      console.log("Audio skipped: Muted by user checkbox.");
      return; // Stop right here
    }
    var audio = document.getElementById('alert-audio');
    
    // Modern browsers return a promise from .play()
    var playPromise = audio.play();
    
    if (playPromise !== undefined) {
        playPromise.then(function() {
            // Playback started successfully
        }).catch(function(error) {
            // Automatic playback was prevented
            console.warn("Audio blocked. Waiting for user interaction.", error);
        });
    }
  }

  function onload_tasks() {
    closeAllHandlers();
    reset_map_controllers();

    if ($(window).width() < 960) {
      site_smaller_map();
    }
    var initialSeq = $('#refresh-container').data('seq');
    window.lastKnownSeq = (initialSeq !== undefined) ? initialSeq : null;
    document.getElementById('enable-sound').checked = false;
  }

  // 1. Create a global safety buffer (e.g., don't fetch more than once every 10 seconds)
  if (typeof site_lastRefreshTime === 'undefined') {
//    console.log("INIT");
    var site_lastRefreshTime = 0;
    window.MIN_REFRESH_INTERVAL = 60000;
    var site_isCurrentlyFetching = false;
    var refreshInterval = null;
  }
    
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
//      console.log("VISIBILITYCHANGE");
      const now = Date.now();
      // Safety Guard A: If a request is already running, do nothing
      if (site_isCurrentlyFetching) return;
//      console.log("NOTCURRENTLYFETCHING");
    
   
      // Safety Guard B: If it refreshed too recently, do nothing
      if (now - site_lastRefreshTime < MIN_REFRESH_INTERVAL) return;
//      console.log("PASTLASTTIME");
      
      // Lock the gate before starting the AJAX call
      site_isCurrentlyFetching = true;
      site_lastRefreshTime = now;
      
      startTimer();
      refreshData();
      site_isCurrentlyFetching = false;
    } else {
      //  The user switched tabs, minimised, or changed apps
      pauseTimer();
    }
  });

  if (window.map_is_ready) {
    onload_tasks();
  } else {
    window.addEventListener('map:loaded', onload_tasks, { once: true });
  }

  startTimer();
  document.getElementById("page_status").innerHTML = '';
  document.body.classList.remove('loading');
</script>

<div id="actionbar" class="span7">
   <div id="crumbs">
     <%=link_to "Home", '/', remote: true,  :id => 'home', :onclick => "linkHandler('home')" %>
     &nbsp;--&gt;&nbsp;
     <b>Spots</b>
   </div>
   <div id="controls">
     <%=  link_to "History", '/spots/history', remote: true,  :id => 'spots_history', :onclick => "linkHandler('spots_history')", class: "btn btn-small btn-primary" %>

     <% if write_access?  %>
       <%=  link_to "Add Spot", "/posts/new?topic_id="+SPOT_TOPIC.to_s, class: "btn btn-small btn-primary",remote: true, id: "add",   :onclick => "linkHandler('add')"%>
     <% end %>
     <%=render 'map_controls'%>
   </div>
</div>

<div id="right_scroll">
  <audio id="alert-audio" src="/icons/bell.mp3" preload="auto"></audio>

  <%= render 'flash' %>
  <h2>Spotted portable - Spots</h2>
   <!-- User control panel to guarantee interaction -->
  <div class="audio-controls">
    <table class="cleanskin2" style="margin-bottom: 3px; width: max-content; white-space: nowrap;">
      <tr>
        <td> Enable Audible Alerts 🔊</td>
        <td>
            <input type="checkbox" id="enable-sound" style="margin-bottom: 0px;" onclick="playAlertSound();">
        </td>
      </tr>
    </table>
  </div>

  <span id="spots"></span>
  <p>
  <% new_parameters=@parameters.gsub(/zone=[A-Za-z]+/,'').gsub(/^&/,'') %>
  <% puts ":#{@zone}:" %>
  <% if @zone=='all' then %>
    <b>Showing all DXCCs</b>.  <i>Show only: 
      <% Continent.all.each do |cont| %>
        <%=link_to cont.name, "/spots?#{raw(new_parameters)}&zone=#{cont.code}", remote: true, id: "add",   :onclick => "linkHandler('add')"%>,
      <% end %>
    </i>
  <% else %>
    <b>Showing <%=Continent.name_from_code(@zone)%></b> spots.  <i><%=link_to "Show All DXCC", "/spots?#{raw(new_parameters)}&zone=all", remote: true, id: "add",   :onclick => "linkHandler('add')"%></i>
  <% end %>
  ||
  <% new_class_parameters=@parameters.gsub(/class=[A-Za-z]+/,'').gsub(/^&/,'')%>
  <% if @class and @class.length>0 then %>
    <b>Showing class <%=@class%></b> only.  <i><%=link_to "Show All Classes", "/spots?#{raw(new_class_parameters)}", remote: true, id: "add",   :onclick => "linkHandler('add')"%></i>
  <% else %>
    <b>Showing all classes</b>. <i>Show only 
       <%=link_to  @site_name, "/spots?#{new_class_parameters}&class=ZLOTA", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
       <%=link_to "SOTA", "/spots?#{new_class_parameters}&class=SOTA", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
       <%=link_to "POTA", "/spots?#{new_class_parameters}&class=POTA", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
       <%=link_to "WWFF", "/spots?#{new_class_parameters}&class=WWFF", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
    </i>
  <% end %>  
  ||
  <% new_mode_parameters=@parameters.gsub(/mode=[A-Za-z]+/,'').gsub(/^&/,'') %>
  <% if @mode and @mode.length>0 then %>
    <b>Showing mode <%=@mode%></b> only.  <i><%=link_to "Show All Modes", "/spots?#{raw(new_mode_parameters)}", remote: true, id: "add",   :onclick => "linkHandler('add')"%></i>
  <% else %>
    <b>Showing all modes</b>. <i>Show only 
       <%=link_to "AM", "/spots?#{raw(new_mode_parameters)}&mode=AM", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
       <%=link_to "CW", "/spots?#{raw(new_mode_parameters)}&mode=CW", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
       <%=link_to "FM", "/spots?#{raw(new_mode_parameters)}&mode=FM", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
       <%=link_to "FT4", "/spots?#{raw(new_mode_parameters)}&mode=FT4", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
       <%=link_to "FT8", "/spots?#{raw(new_mode_parameters)}&mode=FT8", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
       <%=link_to "SSB", "/spots?#{raw(new_mode_parameters)}&mode=SSB", remote: true, id: "add",   :onclick => "linkHandler('add')"%>
  <% end %> 
    </i></p>
  <div id="spot_panel">
    <%= render 'spot_panel' %>
  </div>
</div>
<script>
  document.getElementById('actionbar-full').innerHTML=document.getElementById('actionbar').innerHTML;
</script>

